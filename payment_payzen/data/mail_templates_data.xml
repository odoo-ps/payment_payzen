<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="sale_mail_template_payzen_info" model="mail.template">
        <field name="name">Sale Order - Send By Mail (Payzen info)</field>
        <field name="model_id" ref="model_sale_order"/>
        <field name="body_html" type="html">
            <t t-set="access_action" t-value="object._get_access_action(force_website=True)"/>
            <t t-set="is_online" t-value="access_action and access_action['type'] == 'ir.actions.act_url'"/>
            <t t-set="share_url" t-value="object.get_mail_url()"/>
            <t t-set="base_url" t-value="object.get_base_url()"/>
            <t t-set="access_url" t-value="is_online and share_url and base_url + share_url or ''"/>
            <p>
                Dear <t t-out="object.partner_id.name"/>
                <t t-if="object.partner_id.parent_id">
                    (<i t-out="object.partner_id.parent_id.name"/>)
                </t>
                ,
            </p>
            <p>
                You will find below the details of
                <t t-if="ctx.get('proforma')">your pro-forma invoice</t>
                <t t-else="">your order <strong t-out="object.name"/></t>
                for a total amount of
                <strong t-out="format_amount(object.amount_total, object.currency_id)"/>
                <t t-if="object.recurring_payment_months &lt;= 1">
                    on
                    <t t-out="format_date(object.date_order)"/>
                </t>
                from<t t-out="object.company_id.name"/>.
            </p>

            <p t-if="object.recurring_payment_months > 1">
                <t t-if="object.recurring_payment_months">
                    Payable in <t t-out="object.recurring_payment_months"/> installments
                    <br/>
                </t>
                <t t-if="object.recurring_first_payment_amount">
                    First payment of
                    <t t-out="format_amount(object.recurring_first_payment_amount, object.currency_id)"/>
                    on
                    <t t-out="format_date(object.date_order)"/>
                </t>
                <t t-else="">
                    With payments up to
                    <t t-out="format_amount(object.recurring_payment_monthly_amount, object.currency_id)"/>
                </t>
                <br/>
                <t t-if="object.recurring_second_payment_amount">
                    The first monthly payment will be
                    <t t-out="format_amount(object.recurring_second_payment_amount, object.currency_id)"/>
                    to balance the books,
                    <t t-if="object.recurring_second_payment_date">
                        on
                        <t t-out="format_date(object.recurring_second_payment_date)"/>
                        <br/>
                    </t>
                    Thereafter, instalments of
                    <t t-out="format_amount((object.recurring_payment_monthly_amount), object.currency_id)"/>
                </t>
                <t t-else="">
                    Next payment of
                    <t t-out="format_amount((object.recurring_payment_monthly_amount), object.currency_id)"/>
                    <t t-if="object.recurring_second_payment_date">
                        on
                        <t t-out="format_date(object.recurring_second_payment_date)"/>
                        <br/>
                    </t>
                </t>
            </p>

            <br/>

            <p t-if="is_online and not ctx.get('proforma')">
                <center>
                    <a style="background-color: #1abc9c; padding: 20px; text-decoration: none; color: #fff; border-radius: 5px; font-size: 16px;"
                       class="o_default_snippet_text" t-attf-href="{{ access_url }}">Pay online
                    </a>
                    <br/>
                    <br/>
                    <br/>
                    <span style="color:#888888">(Quote attached)</span>
                </center>
            </p>

            <br/>

            <p style="color:#888888;">
                <t t-if="object.user_id and object.user_id.signature">
                    <t t-out="object.user_id.signature"/>
                </t>
            </p>
        </field>
    </record>
</odoo>
