<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.common.form.custom</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"></field>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]/div[@name='options']" position="after">
                <div>
                    <field name="is_booking_fee"/>
                    <label for="is_booking_fee"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
