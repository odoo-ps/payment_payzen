#. module: payment_payzen
#: model:mail.template,body_html:payment_payzen.sale_mail_template_payzen_info
msgid ""
"<t t-set=\"access_action\" t-value=\"object._get_access_action(force_website=True)\"></t>\n"
"            <t t-set=\"is_online\" t-value=\"access_action and access_action['type'] == 'ir.actions.act_url'\"></t>\n"
"            <t t-set=\"share_url\" t-value=\"object.get_mail_url()\"></t>\n"
"            <t t-set=\"base_url\" t-value=\"object.get_base_url()\"></t>\n"
"            <t t-set=\"access_url\" t-value=\"is_online and share_url and base_url + share_url or ''\"></t>\n"
"            <p>\n"
"                Dear <t t-out=\"object.partner_id.name\"></t>\n"
"                <t t-if=\"object.partner_id.parent_id\">\n"
"                    (<i t-out=\"object.partner_id.parent_id.name\"></i>)\n"
"                </t>\n"
"                ,\n"
"            </p>\n"
"            <p>\n"
"                You will find below the details of\n"
"                <t t-if=\"ctx.get('proforma')\">your pro-forma invoice</t>\n"
"                <t t-else=\"\">your order <strong t-out=\"object.name\"></strong></t>\n"
"                for a total amount of\n"
"                <strong t-out=\"format_amount(object.amount_total, object.currency_id)\"></strong>\n"
"                <t t-if=\"object.recurring_payment_months &lt;= 1\">\n"
"                    on\n"
"                    <t t-out=\"format_date(object.date_order)\"></t>\n"
"                </t>\n"
"                from<t t-out=\"object.company_id.name\"></t>.\n"
"            </p>\n"
"\n"
"            <p t-if=\"object.recurring_payment_months &gt; 1\">\n"
"                <t t-if=\"object.recurring_payment_months\">\n"
"                    Payable in <t t-out=\"object.recurring_payment_months\"></t> installments\n"
"                    <br>\n"
"                </t>\n"
"                <t t-if=\"object.recurring_first_payment_amount\">\n"
"                    First payment of\n"
"                    <t t-out=\"format_amount(object.recurring_first_payment_amount, object.currency_id)\"></t>\n"
"                    on\n"
"                    <t t-out=\"format_date(object.date_order)\"></t>\n"
"                </t>\n"
"                <t t-else=\"\">\n"
"                    With payments up to\n"
"                    <t t-out=\"format_amount(object.recurring_payment_monthly_amount, object.currency_id)\"></t>\n"
"                </t>\n"
"                <br>\n"
"                <t t-if=\"object.recurring_second_payment_amount\">\n"
"                    The first monthly payment will be\n"
"                    <t t-out=\"format_amount(object.recurring_second_payment_amount, object.currency_id)\"></t>\n"
"                    to balance the books,\n"
"                    <t t-if=\"object.recurring_second_payment_date\">\n"
"                        on\n"
"                        <t t-out=\"format_date(object.recurring_second_payment_date)\"></t>\n"
"                        <br>\n"
"                    </t>\n"
"                    Thereafter, instalments of\n"
"                    <t t-out=\"format_amount((object.recurring_payment_monthly_amount), object.currency_id)\"></t>\n"
"                </t>\n"
"                <t t-else=\"\">\n"
"                    Next payment of\n"
"                    <t t-out=\"format_amount((object.recurring_payment_monthly_amount), object.currency_id)\"></t>\n"
"                    <t t-if=\"object.recurring_second_payment_date\">\n"
"                        on\n"
"                        <t t-out=\"format_date(object.recurring_second_payment_date)\"></t>\n"
"                        <br>\n"
"                    </t>\n"
"                </t>\n"
"            </p>\n"
"\n"
"            <br>\n"
"\n"
"            <p t-if=\"is_online and not ctx.get('proforma')\">\n"
"                <center>\n"
"                    <a style=\"background-color: #1abc9c; padding: 20px; text-decoration: none; color: #fff; border-radius: 5px; font-size: 16px;\" class=\"o_default_snippet_text\" t-attf-href=\"{{ access_url }}\">Pay online\n"
"                    </a>\n"
"                    <br>\n"
"                    <br>\n"
"                    <br>\n"
"                    <span style=\"color:#888888\">(Quote attached)</span>\n"
"                </center>\n"
"            </p>\n"
"\n"
"            <br>\n"
"\n"
"            <p style=\"color:#888888;\">\n"
"                <t t-if=\"object.user_id and object.user_id.signature\">\n"
"                    <t t-out=\"object.user_id.signature\"></t>\n"
"                </t>\n"
"            </p>\n"
"        "
msgstr ""
"<t t-set=\"access_action\" t-value=\"object._get_access_action(force_website=True)\"></t>\n"
"            <t t-set=\"is_online\" t-value=\"access_action and access_action['type'] == 'ir.actions.act_url'\"></t>\n"
"            <t t-set=\"share_url\" t-value=\"object.get_mail_url()\"></t>\n"
"            <t t-set=\"base_url\" t-value=\"object.get_base_url()\"></t>\n"
"            <t t-set=\"access_url\" t-value=\"is_online and share_url and base_url + share_url or ''\"></t>\n"
"            <p>\n"
"                Cher <t t-out=\"object.partner_id.name\"></t>\n"
"                <t t-if=\"object.partner_id.parent_id\">\n"
"                    (<i t-out=\"object.partner_id.parent_id.name\"></i>)\n"
"                </t>\n"
"                ,\n"
"            </p>\n"
"            <p>\n"
"                Vous trouverez ci-dessous les détails de\n"
"                <t t-if=\"ctx.get('proforma')\">votre facture pro-forma</t>\n"
"                <t t-else=\"\">votre commande <strong t-out=\"object.name\"></strong></t>\n"
"                pour un montant total de\n"
"                <strong t-out=\"format_amount(object.amount_total, object.currency_id)\"></strong>\n"
"                <t t-if=\"object.recurring_payment_months &lt;= 1\">\n"
"                    le\n"
"                    <t t-out=\"format_date(object.date_order)\"></t>\n"
"                </t>\n"
"                auprès de<t t-out=\"object.company_id.name\"></t>.\n"
"            </p>\n"
"\n"
"            <p t-if=\"object.recurring_payment_months &gt; 1\">\n"
"                <t t-if=\"object.recurring_payment_months\">\n"
"                    Payable en <t t-out=\"object.recurring_payment_months\"></t> fois\n"
"                    <br>\n"
"                </t>\n"
"                <t t-if=\"object.recurring_first_payment_amount\">\n"
"                    Premier paiement de\n"
"                    <t t-out=\"format_amount(object.recurring_first_payment_amount, object.currency_id)\"></t>\n"
"                    le\n"
"                    <t t-out=\"format_date(object.date_order)\"></t>\n"
"                </t>\n"
"                <t t-else=\"\">\n"
"                    Avec des paiements à hauteur de\n"
"                    <t t-out=\"format_amount(object.recurring_payment_monthly_amount, object.currency_id)\"></t>\n"
"                </t>\n"
"                <br>\n"
"                <t t-if=\"object.recurring_second_payment_amount\">\n"
"                    La première mensualité sera de\n"
"                    <t t-out=\"format_amount(object.recurring_second_payment_amount, object.currency_id)\"></t>\n"
"                    pour faire la balance,\n"
"                    <t t-if=\"object.recurring_second_payment_date\">\n"
"                        le\n"
"                        <t t-out=\"format_date(object.recurring_second_payment_date)\"></t>\n"
"                        <br>\n"
"                    </t>\n"
"                    Ensuite, paiements de\n"
"                    <t t-out=\"format_amount((object.recurring_payment_monthly_amount), object.currency_id)\"></t>\n"
"                </t>\n"
"                <t t-else=\"\">\n"
"                    Prochain paiement de\n"
"                    <t t-out=\"format_amount((object.recurring_payment_monthly_amount), object.currency_id)\"></t>\n"
"                    <t t-if=\"object.recurring_second_payment_date\">\n"
"                        le\n"
"                        <t t-out=\"format_date(object.recurring_second_payment_date)\"></t>\n"
"                        <br>\n"
"                    </t>\n"
"                </t>\n"
"            </p>\n"
"\n"
"            <br>\n"
"\n"
"            <p t-if=\"is_online and not ctx.get('proforma')\">\n"
"                <center>\n"
"                    <a style=\"background-color: #1abc9c; padding: 20px; text-decoration: none; color: #fff; border-radius: 5px; font-size: 16px;\" class=\"o_default_snippet_text\" t-attf-href=\"{{ access_url }}\">Je règle en ligne\n"
"                    </a>\n"
"                    <br>\n"
"                    <br>\n"
"                    <br>\n"
"                    <span style=\"color:#888888\">(Devis en pièce-jointe)</span>\n"
"                </center>\n"
"            </p>\n"
"\n"
"            <br>\n"
"\n"
"            <p style=\"color:#888888;\">\n"
"                <t t-if=\"object.user_id and object.user_id.signature\">\n"
"                    <t t-out=\"object.user_id.signature\"></t>\n"
"                </t>\n"
"            </p>\n"
"        "

